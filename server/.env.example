# ==========================================
# Bharat Heritage Backend Environment Config
# ==========================================

# Server Port
PORT=8080

# Master cryptographic secret for salting OTP hashes
OTP_SECRET_SALT=generate_a_random_32_byte_hex_string_here

# ----------------------------------------------------
# SMS PROVIDER 1: TWILIO (Global & India SMS delivery)
# ----------------------------------------------------
# Get credentials from twilio.com/console
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ----------------------------------------------------
# SMS PROVIDER 2: FAST2SMS (Cost-effective for India +91)
# ----------------------------------------------------
# Get API key from fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ----------------------------------------------------
# AI ENGINE: GOOGLE GEMINI API
# ----------------------------------------------------
# Used exclusively server-side for heritage AI chat
GEMINI_API_KEY=your_gemini_api_key_here
